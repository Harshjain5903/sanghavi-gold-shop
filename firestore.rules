rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = Firebase custom claim, set server-side with the Admin SDK.
    // Mirrors hasAdminClaim() in lib/adminAuth.ts.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function profileFields() {
      return ['uid', 'name', 'email', 'mobile', 'createdAt', 'isGuest'];
    }

    // Value checks on the resulting document; absent fields are allowed.
    function hasValidProfileValues(data, userId) {
      return (!('uid' in data) || data.uid == userId)
        && (!('name' in data) || isShortString(data.name, 100))
        && (!('email' in data) || isShortString(data.email, 254))
        && (!('mobile' in data) || isShortString(data.mobile, 20))
        && (!('createdAt' in data) || isShortString(data.createdAt, 40))
        && (!('isGuest' in data) || data.isGuest is bool);
    }

    // Legacy copy only: the catalog now lives in PostgreSQL behind the API.
    // Locked so nobody edits a stale copy by mistake (the Admin SDK can still read it as a backup).
    match /products/{productId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users may only touch allow-listed fields, so they can never grant themselves a role.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(profileFields())
        && hasValidProfileValues(request.resource.data, userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && hasValidProfileValues(request.resource.data, userId);
      allow delete: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
