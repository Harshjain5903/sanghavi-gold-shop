# Copy this file to .env and fill in real values. Never commit .env.

# Neon → your project → Connect → connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Firebase service account as ONE line of base64:
#   base64 -i ~/Downloads/sanghavi-gold-firebase-adminsdk-XXXX.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Comma-separated emails that are shop owners (can manage the admin team).
OWNER_EMAILS="hjain29@uic.edu"

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000,https://sanghavigold.com,https://www.sanghavigold.com"

PORT=4000

# Cloudinary (image hosting) - Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
