// Database schema for the Sanghavi Gold API.
// After editing: `npm run prisma:migrate -- --name <change>` creates a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
}

enum MemberStatus {
  // Invited by email, but the person has not signed in with a verified email yet.
  INVITED
  // Signed in with a verified email; their Firebase account carries the role claim.
  ACTIVE
}

// Who may use the admin portal. This table is the source of truth;
// Firebase custom claims are a cached copy kept in sync by TeamService.
model TeamMember {
  id             String       @id @default(uuid())
  email          String       @unique // always stored lowercase
  role           TeamRole
  status         MemberStatus @default(INVITED)
  firebaseUid    String?      @unique
  invitedByEmail String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("team_members")
}

// Append-only record of sensitive actions (who did what, when).
model AuditLog {
  id         String   @id @default(uuid())
  actorUid   String
  actorEmail String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------- Catalog & pricing ----------

enum MetalPurity {
  GOLD_24K
  GOLD_22K
  GOLD_18K
  SILVER
  NONE // no metal-rate pricing (e.g. not yet filled in)
}

enum MakingChargeType {
  PER_GRAM // ₹ per gram of net weight
  PERCENT // % of the metal value
  FLAT // fixed ₹ per piece
}

// Prices are not stored: they are computed from today's metal rate on every read.
model Product {
  id                   String           @id @default(cuid())
  name                 String
  description          String           @default("")
  categories           String[]
  subcategory          String?
  images               String[]
  videos               String[]
  specifications       Json             @default("[]")
  metalPurity          MetalPurity      @default(NONE)
  netWeightGrams       Decimal?         @db.Decimal(10, 3)
  weightLabel          String? // free-text weight shown on cards, e.g. "12.5g"
  makingChargeType     MakingChargeType @default(PERCENT)
  makingChargeValue    Decimal          @default(0) @db.Decimal(12, 2)
  stoneValue           Decimal          @default(0) @db.Decimal(12, 2)
  priceOnRequest       Boolean          @default(false) // admin forces "Price on Request"
  cardDisplayMode      String           @default("price")
  inStock              Boolean          @default(true)
  isNew                Boolean          @default(false)
  isTrending           Boolean          @default(false)
  isFeaturedCollection Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([createdAt])
  @@map("products")
}

// Every rate update adds a row, so the full price history is kept. Current = newest row.
model MetalRateSnapshot {
  id                String   @id @default(uuid())
  gold24kPerGram    Decimal  @db.Decimal(12, 2)
  gold22kPerGram    Decimal  @db.Decimal(12, 2)
  gold18kPerGram    Decimal  @db.Decimal(12, 2)
  silverPerGram     Decimal  @db.Decimal(12, 2)
  goldDisplayUnit   String   @default("10g")
  silverDisplayUnit String   @default("1kg")
  createdByEmail    String
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("metal_rate_snapshots")
}
